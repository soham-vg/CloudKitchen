<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aadya's Non Veg Kitchen | Premium Cloud Kitchen</title>
    <link rel="icon" href="images/logo_new.ico" type="image/x-icon">
    <meta name="description"
        content="Order premium quality food from Aadya's Non Veg Kitchen. Fast delivery, fresh ingredients, and unforgettable taste.">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&family=Inter:wght@400;500;600&display=swap"
        rel="stylesheet">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <!-- Pre-load Dark Theme Script to avoid FOUC -->
    <script>
        const savedTheme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', savedTheme);
    </script>

    <style>
        /* ================= CSS VARIABLES ================= */
        :root {
            --primary: #ff4757;
            --primary-hover: #ff2a3e;
            --primary-rgb: 255, 71, 87;
            --bg-color: #f8f9fa;
            --surface-color: #ffffff;
            --text-color: #2f3542;
            --text-light: #747d8c;
            --border-color: #e4e8ec;
            --glass-bg: rgba(255, 255, 255, 0.85);
            --glass-border: rgba(255, 255, 255, 0.5);
            --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.05);
            --shadow-md: 0 8px 24px rgba(0, 0, 0, 0.08);
            --shadow-lg: 0 12px 32px rgba(0, 0, 0, 0.12);
            --transition: all 0.3s ease;
        }

        [data-theme="dark"] {
            --bg-color: #121212;
            --surface-color: #1e1e1e;
            --text-color: #f1f2f6;
            --text-light: #a4b0be;
            --border-color: #2d3436;
            --glass-bg: rgba(30, 30, 30, 0.85);
            --glass-border: rgba(255, 255, 255, 0.05);
            --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.4);
            --shadow-md: 0 8px 24px rgba(0, 0, 0, 0.6);
            --shadow-lg: 0 12px 32px rgba(0, 0, 0, 0.8);
        }

        /* ================= GLOBAL TYPOGRAPHY & RESET ================= */
        html {
            scroll-behavior: smooth;
            scroll-padding-top: 80px;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            transition: background-color 0.3s ease, color 0.3s ease;
            overflow-x: hidden;
        }

        h1,
        h2,
        h3,
        h4,
        h5,
        h6 {
            font-family: 'Outfit', sans-serif;
            color: var(--text-color);
        }

        p {
            color: var(--text-light);
        }

        .text-primary {
            color: var(--primary) !important;
        }

        .bg-primary {
            background-color: var(--primary) !important;
        }

        .bg-surface {
            background-color: var(--surface-color);
        }

        .text-muted {
            color: var(--text-light) !important;
        }

        section {
            padding: 90px 0;
        }

        .section-bg-alt {
            background-color: var(--surface-color);
        }

        /* ================= COMPONENTS & BUTTONS ================= */
        .btn {
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            transition: var(--transition);
        }

        .btn-primary {
            background-color: var(--primary);
            border-color: var(--primary);
            color: white;
        }

        .btn-primary:hover {
            background-color: var(--primary-hover);
            border-color: var(--primary-hover);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(var(--primary-rgb), 0.3);
        }

        .btn-outline-primary {
            color: var(--primary);
            border-color: var(--primary);
        }

        .btn-outline-primary:hover {
            background-color: var(--primary);
            border-color: var(--primary);
            color: white;
            transform: translateY(-2px);
        }

        /* ================= GLASSMORPHISM & UTILS ================= */
        .glass-card {
            background: var(--glass-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--glass-border);
        }

        /* ================= NAVBAR ================= */
        .navbar {
            background-color: var(--glass-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border-color);
            transition: all 0.3s ease;
            padding: 15px 0;
        }

        .navbar.scrolled {
            box-shadow: var(--shadow-md);
            padding: 10px 0;
        }

        .navbar-brand {
            font-family: 'Outfit', sans-serif;
            font-weight: 800;
            font-size: 1.8rem;
            color: var(--text-color) !important;
        }

        .nav-link {
            color: var(--text-color) !important;
            font-weight: 500;
            margin: 0 10px;
            position: relative;
        }

        .nav-link::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: 0;
            left: 50%;
            background-color: var(--primary);
            transition: all 0.3s ease;
            transform: translateX(-50%);
        }

        .nav-link:hover::after,
        .nav-link.active::after {
            width: 80%;
        }

        .theme-toggle-btn {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            border: 1px solid var(--border-color);
            background: var(--surface-color);
            color: var(--text-color);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
        }

        .theme-toggle-btn:hover {
            background: var(--border-color);
        }

        /* ================= HERO SECTION ================= */
        .hero-section {
            position: relative;
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding-top: 180px;
            background: linear-gradient(135deg, rgba(var(--primary-rgb), 0.08) 0%, rgba(255, 255, 255, 0) 100%);
        }

        [data-theme="dark"] .hero-section {
            background: linear-gradient(135deg, rgba(var(--primary-rgb), 0.15) 0%, rgba(18, 18, 18, 0) 100%);
        }

        .hero-img-wrapper {
            position: relative;
            z-index: 1;
        }

        .floating-emoji {
            position: absolute;
            font-size: 2.5rem;
            z-index: 10;
            pointer-events: none;
            animation: emojiFloat 4s ease-in-out infinite;
            filter: drop-shadow(0 5px 15px rgba(0, 0, 0, 0.1));
        }

        .emoji-1 {
            top: 10%;
            left: -5%;
            animation-delay: 0s;
        }

        .emoji-2 {
            top: 65%;
            left: -10%;
            animation-delay: 1s;
        }

        .emoji-3 {
            top: 15%;
            right: -5%;
            animation-delay: 2s;
        }

        .emoji-4 {
            top: 80%;
            right: 5%;
            animation-delay: 3s;
        }

        @keyframes emojiFloat {

            0%,
            100% {
                transform: translateY(0) rotate(0deg);
            }

            50% {
                transform: translateY(-20px) rotate(10deg);
            }
        }

        .hero-img {
            border-radius: 50%;
            width: 100%;
            max-width: 550px;
            box-shadow: var(--shadow-lg);
            animation: float 6s ease-in-out infinite;
            border: 8px solid var(--surface-color);
            object-fit: cover;
            aspect-ratio: 1;
        }

        @keyframes float {
            0% {
                transform: translateY(0px);
            }

            50% {
                transform: translateY(-20px);
            }

            100% {
                transform: translateY(0px);
            }
        }

        /* ================= FOOD ANIMATION ================= */
        .food-anim-container {
            position: relative;
            width: 100%;
            max-width: 500px;
            aspect-ratio: 1;
            margin: 0 auto;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .typing-cursor {
            font-weight: bold;
            color: var(--primary);
            animation: blink 1s step-end infinite;
        }

        @keyframes blink {
            50% {
                opacity: 0;
            }
        }

        .ingredient-wrapper {
            position: absolute;
            top: 50%;
            left: 50%;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            opacity: 0;
            z-index: 2;
            animation: dropIngredient 10s infinite cubic-bezier(0.4, 0, 0.2, 1);
        }

        .ingredient-img {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            object-fit: cover;
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.3);
        }

        .ingredient-name {
            background: var(--surface-color);
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text-color);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            white-space: nowrap;
        }

        .ing-1 {
            --startX: -150px;
            --startY: -200px;
            animation-delay: 0s;
        }

        .ing-2 {
            --startX: 0px;
            --startY: -250px;
            animation-delay: 0.5s;
        }

        .ing-3 {
            --startX: 150px;
            --startY: -180px;
            animation-delay: 1s;
        }

        .ing-4 {
            --startX: -180px;
            --startY: -50px;
            animation-delay: 0.3s;
        }

        .ing-5 {
            --startX: 180px;
            --startY: -20px;
            animation-delay: 0.8s;
        }

        .ing-6 {
            --startX: 0px;
            --startY: -80px;
            animation-delay: 0.4s;
        }

        .ing-7 {
            --startX: 120px;
            --startY: -280px;
            animation-delay: 0.2s;
        }

        @keyframes dropIngredient {
            0% {
                transform: translate(calc(-50% + var(--startX)), calc(-50% + var(--startY) - 50px)) scale(0.8);
                opacity: 0;
            }

            8% {
                transform: translate(calc(-50% + var(--startX)), calc(-50% + var(--startY))) scale(1);
                opacity: 1;
            }

            22% {
                transform: translate(calc(-50% + var(--startX)), calc(-50% + var(--startY))) scale(1);
                opacity: 1;
            }

            35% {
                transform: translate(-50%, -50%) scale(0.2) rotate(180deg);
                opacity: 0;
            }

            100% {
                transform: translate(-50%, -50%) scale(0);
                opacity: 0;
            }
        }

        .cooking-bowl {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 140px;
            height: 140px;
            margin-top: -70px;
            margin-left: -70px;
            background: linear-gradient(135deg, #444, #111);
            border-radius: 50%;
            z-index: 1;
            opacity: 0;
            box-shadow: inset 0 10px 20px rgba(255, 255, 255, 0.3), 0 20px 40px rgba(0, 0, 0, 0.6);
            border: 4px solid #555;
            animation: cookBowl 10s infinite cubic-bezier(0.4, 0, 0.2, 1);
        }

        .cooking-bowl::after {
            content: '';
            position: absolute;
            top: 10%;
            left: 10%;
            right: 10%;
            bottom: 10%;
            border-radius: 50%;
            background: radial-gradient(circle, #ff9f43 0%, #ff4757 70%, #2f3542 100%);
            animation: bowlGlow 10s infinite;
        }

        @keyframes cookBowl {

            0%,
            25% {
                transform: scale(0) rotate(0deg);
                opacity: 0;
            }

            30% {
                transform: scale(1) rotate(180deg);
                opacity: 1;
            }

            35%,
            45% {
                transform: scale(1.2) rotate(1440deg);
                opacity: 1;
                filter: blur(2px);
            }

            50% {
                transform: scale(0) rotate(2000deg);
                opacity: 0;
            }

            100% {
                transform: scale(0);
                opacity: 0;
            }
        }

        @keyframes bowlGlow {

            0%,
            30% {
                opacity: 0;
            }

            35%,
            45% {
                opacity: 0.8;
            }

            50%,
            100% {
                opacity: 0;
            }
        }

        .final-dish {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            z-index: 3;
            border: 8px solid var(--surface-color);
            box-shadow: var(--shadow-lg);
            opacity: 0;
            animation: revealDish 10s infinite cubic-bezier(0.25, 1, 0.5, 1);
        }

        @keyframes revealDish {

            0%,
            48% {
                transform: scale(0.2) rotate(-90deg);
                opacity: 0;
                filter: blur(20px);
            }

            53% {
                transform: scale(1.05) rotate(0deg);
                opacity: 1;
                filter: blur(0px);
            }

            58% {
                transform: scale(1);
                opacity: 1;
            }

            90% {
                transform: scale(1);
                opacity: 1;
                filter: blur(0px);
            }

            95%,
            100% {
                transform: scale(0.8);
                opacity: 0;
                filter: blur(20px);
            }
        }

        /* Looping switch */
        .dish-anim-wrapper {
            position: relative;
            width: 100%;
            max-width: 500px;
            aspect-ratio: 1;
            margin: 0 auto;
        }

        .dish-anim-container {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            visibility: hidden;
            animation: dishLoop 20s infinite;
        }

        .dish-1 {
            animation-delay: 0s;
        }

        .dish-2 {
            animation-delay: 10s;
        }

        @keyframes dishLoop {

            0%,
            45% {
                opacity: 1;
                visibility: visible;
            }

            50%,
            100% {
                opacity: 0;
                visibility: hidden;
            }
        }

        /* ================= MENU CARDS ================= */
        .card {
            background-color: var(--surface-color);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            overflow: hidden;
            box-shadow: var(--shadow-sm);
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s ease;
        }

        .card:hover {
            transform: translateY(-10px);
            box-shadow: var(--shadow-lg);
        }

        .menu-img {
            height: 240px;
            object-fit: cover;
            transition: transform 0.6s ease;
        }

        .card:hover .menu-img {
            transform: scale(1.08);
        }

        .price {
            color: var(--primary);
            font-family: 'Outfit', sans-serif;
        }

        /* ================= FEATURES & WHY US ================= */
        .feature-icon-box {
            width: 80px;
            height: 80px;
            border-radius: 20px;
            background: rgba(var(--primary-rgb), 0.1);
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            margin: 0 auto 20px;
            transition: var(--transition);
        }

        .feature-card:hover .feature-icon-box {
            background: var(--primary);
            color: white;
            transform: rotate(10deg);
        }

        /* ================= FORMS & INPUTS ================= */
        .form-control {
            background-color: var(--bg-color);
            border: 1px solid var(--border-color);
            color: var(--text-color);
            padding: 12px 20px;
            border-radius: 12px;
        }

        .form-control:focus {
            background-color: var(--bg-color);
            color: var(--text-color);
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(var(--primary-rgb), 0.15);
        }

        /* ================= BACK TO TOP ================= */
        #back-to-top {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: auto;
            height: auto;
            padding: 12px 24px;
            border-radius: 50px;
            background: var(--primary);
            color: #fff;
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 1020;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
            box-shadow: var(--shadow-md);
            border: none;
            cursor: pointer;
            font-size: 1.5rem;
        }

        @keyframes bounceBack {

            0%,
            20%,
            50%,
            80%,
            100% {
                transform: translateY(0);
            }

            40% {
                transform: translateY(-10px);
            }

            60% {
                transform: translateY(-5px);
            }
        }

        #back-to-top.show {
            opacity: 1;
            visibility: visible;
            animation: bounceBack 2s infinite;
        }

        #back-to-top:hover {
            background: var(--primary-hover);
        }

        /* ================= ANIMATIONS ================= */
        .fade-up {
            opacity: 0;
            transform: translateY(40px);
            transition: opacity 0.8s ease, transform 0.8s ease;
        }

        .fade-up.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* ================= LOADER ================= */
        #loader {
            position: fixed;
            inset: 0;
            background: var(--bg-color);
            z-index: 9999;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            transition: opacity 0.6s ease;
        }

        .spinner {
            width: 60px;
            height: 60px;
            border: 5px solid var(--border-color);
            border-top-color: var(--primary);
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            100% {
                transform: rotate(360deg);
            }
        }

        /* ================= FOOTER ================= */
        footer {
            background-color: var(--surface-color);
            border-top: 1px solid var(--border-color);
        }

        .social-links a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--bg-color);
            color: var(--text-color);
            transition: var(--transition);
            text-decoration: none;
        }

        .social-links a:hover {
            background: var(--primary);
            color: white;
            transform: translateY(-3px);
        }

        /* ================= CUSTOM TESTIMONIAL SLIDER ================= */
        .testimonial-slider-container {
            position: relative;
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            height: 400px;
            overflow: hidden;
            padding: 0 60px; /* Leave space for arrows */
        }

        .testimonial-slider {
            position: relative;
            width: 100%;
            height: 100%;
        }

        .testimonial-slide {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 50%;
            transform: translate(-50%, -50%) scale(0.8);
            opacity: 0;
            visibility: hidden;
            transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.6s ease, visibility 0.6s ease;
            z-index: 1;
        }

        .testimonial-slide.active {
            transform: translate(-50%, -50%) scale(1);
            opacity: 1;
            visibility: visible;
            z-index: 3;
        }

        /* Hover popup effect for center slide */
        .testimonial-slide.active:hover .testimonial-card {
            transform: scale(1.03) translateY(-5px);
            box-shadow: var(--shadow-lg);
            border-color: rgba(var(--primary-rgb), 0.3);
        }

        .testimonial-slide.prev {
            transform: translate(-140%, -50%) scale(0.8);
            opacity: 0.4;
            visibility: visible;
            z-index: 2;
            cursor: pointer;
        }

        .testimonial-slide.next {
            transform: translate(40%, -50%) scale(0.8);
            opacity: 0.4;
            visibility: visible;
            z-index: 2;
            cursor: pointer;
        }

        .testimonial-card {
            background-color: var(--surface-color);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 35px;
            box-shadow: var(--shadow-md);
            text-align: center;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            transition: transform 0.4s ease, box-shadow 0.4s ease, border-color 0.4s ease, background-color 0.3s ease;
        }

        .testimonial-text {
            font-size: 1.1rem;
            line-height: 1.6;
            color: var(--text-color);
            font-style: italic;
            margin-bottom: 20px;
        }

        .testimonial-name {
            color: var(--primary);
            font-family: 'Outfit', sans-serif;
            font-weight: 700;
        }

        /* Arrows styling */
        .slider-arrow {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: var(--surface-color);
            border: 1px solid var(--border-color);
            color: var(--text-color);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 10;
            transition: var(--transition);
            box-shadow: var(--shadow-sm);
        }

        .slider-arrow:hover {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
            transform: translateY(-50%) scale(1.1);
            box-shadow: 0 5px 15px rgba(var(--primary-rgb), 0.3);
        }

        .prev-arrow {
            left: 20px;
        }

        .next-arrow {
            right: 20px;
        }

        .testimonial-dots {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin-top: 20px;
        }

        .testimonial-dots .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background-color: var(--border-color);
            cursor: pointer;
            transition: var(--transition);
        }

        .testimonial-dots .dot.active {
            background-color: var(--primary);
            transform: scale(1.2);
        }

        @media (max-width: 992px) {
            .testimonial-slide {
                width: 70%;
            }
            .testimonial-slide.prev {
                transform: translate(-120%, -50%) scale(0.8);
            }
            .testimonial-slide.next {
                transform: translate(20%, -50%) scale(0.8);
            }
        }

        @media (max-width: 768px) {
            .testimonial-slider-container {
                height: 480px;
                padding: 0 45px;
            }
            .testimonial-slide {
                width: 85%;
            }
            .testimonial-slide.prev {
                transform: translate(-108%, -50%) scale(0.8);
                opacity: 0.15;
            }
            .testimonial-slide.next {
                transform: translate(8%, -50%) scale(0.8);
                opacity: 0.15;
            }
            .slider-arrow {
                width: 40px;
                height: 40px;
            }
            .prev-arrow {
                left: 5px;
            }
            .next-arrow {
                right: 5px;
            }
        }

        @media (max-width: 576px) {
            .testimonial-slider-container {
                height: 520px;
                padding: 0 10px;
            }
            .testimonial-slide {
                width: 90%;
            }
            .testimonial-slide.prev {
                opacity: 0;
                visibility: hidden;
            }
            .testimonial-slide.next {
                opacity: 0;
                visibility: hidden;
            }
            .slider-arrow {
                background: rgba(var(--primary-rgb), 0.1);
                border: none;
                color: var(--primary);
            }
            .slider-arrow:hover {
                background: var(--primary);
                color: white;
            }
        }
    </style>
</head>

